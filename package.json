{
  "name": "lost-ark-raid-manager",
  "version": "1.0.0",
  "description": "Lost Ark Raid Manager - приложение для управления рейдами, персонажами и автоматизации",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node start.js",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "lost-ark",
    "raid-manager",
    "electron",
    "gaming"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "moment": "^2.29.4",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.4",
    "tesseract.js": "^5.0.4",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.lostark.raidmanager",
    "productName": "Lost Ark Raid Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
